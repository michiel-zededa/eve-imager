<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>com.raspberrypi.rpi-imager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>EVE Imager</name>
  <summary>LF Edge EVE-OS imaging utility</summary>
  <description>
    <p>
      EVE Imager downloads LF Edge EVE-OS installer images directly from
      GitHub, lets you pre-configure device settings (controller URL, network,
      WiFi), and writes the image to a USB drive — all in one guided workflow.
    </p>
    <p>
      Once you've selected a version, architecture, hypervisor and platform,
      the utility fetches the matching installer image, streams it straight to
      the USB drive, and verifies the written data afterwards.
    </p>
    <p>
      EVE Imager also caches the downloaded image – that is to say, it saves a
      local copy on your computer, so you can program additional drives without
      having to download the file again.
    </p>
  </description>
  <launchable type="desktop-id">com.raspberrypi.rpi-imager.desktop</launchable>
  <url type="homepage">https://github.com/michiel-zededa/eve-imager</url>
  <url type="bugtracker">https://github.com/michiel-zededa/eve-imager/issues</url>
  <developer_name>ZEDEDA, Inc.</developer_name>
  <provides>
    <binary>eve-imager</binary>
  </provides>
  <releases>
    <release version="@IMAGER_VERSION_STR@" />
  </releases>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>
</component>
